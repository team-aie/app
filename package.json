{
  "name": "aie",
  "version": "1.0.0-beta.3",
  "description": "Desktop Vocal Booth & Turnkey OpenUtau / vLabeler Voicebank Builder",
  "author": "team-aie <yi.iluminar@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/team-aie/app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-aie/app.git"
  },
  "bugs": {
    "url": "https://github.com/team-aie/app/issues"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "bootstrap:worktree": "node scripts/bootstrap-worktree.mjs",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "chardet": "^2.1.0",
    "chokidar": "^4.0.3",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.9",
    "fflate": "^0.8.2",
    "i18next": "^24.2.2",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^0.475.0",
    "pitchy": "^4.1.0",
    "radix-ui": "^1.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "wavefile": "^11.0.0",
    "yaml": "^2.7.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "jsdom": "^26.0.0",
    "rollup-plugin-license": "^3.6.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
